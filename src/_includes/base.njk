{%- set t = i18n[lang] -%}
{%- set altUrl = page.url | otherLang(lang) -%}
{%- set ruUrl = page.url if lang == "ru" else altUrl -%}
{%- set enUrl = page.url if lang == "en" else altUrl -%}
{%- set home = t.prefix + "/" -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="ru" href="{{ site.url }}{{ ruUrl }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ ruUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ t.name }}">
  <meta property="og:locale" content="{{ t.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or images.og }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f7f5f1">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/cormorant-garamond-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/manrope-cyrillic-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- if preloadHero %}
  <link rel="preload" as="image" type="image/webp" imagesrcset="{% for w in images.hero.widths %}{{ images.hero.src | withBase }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" imagesizes="(min-width: 960px) 62vw, 100vw">
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">{{ "Перейти к содержанию" if lang == "ru" else "Skip to content" }}</a>
  <header class="site-header{% if headerOverlay %} site-header--overlay{% endif %}">
    <a class="site-header__catalogue link" href="{{ home }}#works">{{ t.nav.catalogue }}</a>
    <a class="site-header__name" href="{{ home }}">{{ t.name }}</a>
    <div class="site-header__right">
      <nav class="lang" aria-label="{{ 'Язык' if lang == 'ru' else 'Language' }}">
        <a href="{{ ruUrl }}" hreflang="ru" lang="ru"{% if lang == "ru" %} aria-current="true"{% endif %}>RU</a>
        <span aria-hidden="true">/</span>
        <a href="{{ enUrl }}" hreflang="en" lang="en"{% if lang == "en" %} aria-current="true"{% endif %}>EN</a>
      </nav>
      <a class="btn btn--small" href="{{ site.telegram }}" target="_blank" rel="noopener">{{ t.nav.write }}</a>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <a class="site-footer__name" href="{{ home }}">{{ t.name }}</a>
      <nav class="site-footer__nav">
        <a class="link" href="{{ home }}#works">{{ t.nav.catalogue }}</a>
        <a class="link" href="{{ home }}#faq-how-to-buy">{{ t.nav.howToBuy }}</a>
      </nav>
      <div class="site-footer__contacts">
        <a class="link" href="{{ site.telegram }}" target="_blank" rel="noopener">Telegram {{ site.telegramHandle }}</a>
        <a class="link" href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
      <nav class="lang" aria-label="{{ 'Язык' if lang == 'ru' else 'Language' }}">
        <a href="{{ ruUrl }}" hreflang="ru" lang="ru"{% if lang == "ru" %} aria-current="true"{% endif %}>RU</a>
        <span aria-hidden="true">/</span>
        <a href="{{ enUrl }}" hreflang="en" lang="en"{% if lang == "en" %} aria-current="true"{% endif %}>EN</a>
      </nav>
      <p class="site-footer__copy">{{ t.footer.copyright }}</p>
    </div>
  </footer>

  <div class="toast" role="status" aria-live="polite" hidden></div>

  <dialog class="lightbox" aria-label="{{ t.work.zoom }}">
    <button class="lightbox__close" type="button" aria-label="{{ t.work.close }}">×</button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="{{ t.work.prev }}">‹</button>
    <figure class="lightbox__figure"><img alt=""></figure>
    <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="{{ t.work.next }}">›</button>
  </dialog>

  <script src="/assets/js/main.js" defer></script>
  {%- if tryon %}
  <script src="/assets/js/tryon.js" defer></script>
  {%- endif %}
</body>
</html>
